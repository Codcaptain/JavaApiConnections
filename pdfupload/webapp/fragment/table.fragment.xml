<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
     <Dialog>
        <content>
            <PDFViewer
                class="sapUiSmallMarginEnd"
                source="{localModel>/tableData/Source}"
                title="{localModel>/tableData/Title}"
                height="{localModel>/tableData/Height}"
                width="auto"
                isTrustedSource="true"
            />
        </content>
        <endButton>
            <Button
                text="close"
                press="onCloseTable"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
